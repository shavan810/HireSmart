# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/hiresmart

# ---- Auth ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Seeded admin (used by npm run seed / seed:admin) ----
ADMIN_NAME=HireSmart Admin
ADMIN_EMAIL=admin@hiresmart.com
ADMIN_PASSWORD=Admin@12345

# ---- Cloudinary (resume + image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Google Gemini (AI resume analysis) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Nodemailer (optional - leave SMTP_HOST empty to disable emails) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HireSmart <no-reply@hiresmart.com>"
SUPPORT_EMAIL=
